# === Networking ===
KAFKA_BROKER=kafka:9092
REDIS_HOST=redis
REDIS_PORT=6379

# === Kafka topics ===
URL_TOPIC=url_stream
FEATURE_TOPIC=url_features
PREDICTION_TOPIC=url_predictions

# === Celery ===
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# === Models ===
MODEL_NAMES=bert-base-uncased,roberta-base,distilbert-base
BATCH_SIZE=32

# === App tuning ===
LOG_LEVEL=INFO
